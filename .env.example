# Copy to .env and adjust. Read by the server (node --env-file).
DATABASE_URL=postgres://vfl:vfl_local_dev@localhost:5433/vocal_for_local
PORT=4000
NODE_ENV=development
# Public origin(s) allowed to make state-changing requests (comma-separated).
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hostnames that render the platform (not a custom-domain store).
PLATFORM_HOSTS=localhost,127.0.0.1,vocalforlocal.store,www.vocalforlocal.store
UPLOAD_DIR=./uploads
# ---- Login OTP (owners + shoppers log in with a 10-digit mobile + OTP; no passwords) ----
# Provider (server/src/otp/providers.js):
#   fixed   – local testing: every code is OTP_FIXED_CODE (refused when NODE_ENV=production)
#   console – local testing: random code printed in the API log
#   email   – temporary production setup: each code is emailed to OTP_EMAIL_TO via SMTP (Gmail);
#             the merchant WhatsApps OTP_HELP_WHATSAPP and you reply with the code
#   sms     – once an SMS gateway is integrated
# Default: fixed in development, email in production.
OTP_PROVIDER=fixed
OTP_FIXED_CODE=898989
OTP_EMAIL_TO=creativebunnyofficial@gmail.com
# Number shown to users on the free tier: "WhatsApp this number to get your OTP".
OTP_HELP_WHATSAPP=919353095481
# SMTP for the email provider. Gmail: smtp.gmail.com:465 with an App Password (not your Google password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vocal For Local OTP <creativebunnyofficial@gmail.com>"
# Canonical public URL for SEO (sitemap, canonical links). Leave empty locally.
PUBLIC_URL=
# Optional search-engine verification (content="…" of the meta tag). DNS TXT verification needs neither.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
