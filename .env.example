# Copy to .env and adjust. Read by the server (node --env-file).
DATABASE_URL=postgres://vfl:vfl_local_dev@localhost:5433/vocal_for_local
PORT=4000
NODE_ENV=development
# Public origin(s) allowed to make state-changing requests (comma-separated).
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hostnames that render the platform (not a custom-domain store).
PLATFORM_HOSTS=localhost,127.0.0.1,vocalforlocal.store,www.vocalforlocal.store
UPLOAD_DIR=./uploads
# ---- Login OTP (no passwords: owners log in with a 10-digit mobile + OTP, shoppers with email or mobile + OTP) ----
# Shoppers (optional accounts): email – code emailed directly via the SMTP settings below (default);
#                               mobile – 10-digit number, code delivered by OTP_PROVIDER like owners' codes.
CUSTOMER_LOGIN=email
# Store owners: email – code emailed directly (default); the WhatsApp number for orders is given when submitting the
#                       store for approval and is marked verified when the platform approves it.
#               mobile – 10-digit number, code delivered by OTP_PROVIDER (the older flow).
OWNER_LOGIN=email
# Google Sign-In for owners and shoppers (web OAuth client ID; public). Defaults to the platform's own client in
# server/src/config.js; set to empty to turn Google sign-in off. Its Authorized JavaScript origins must list every
# origin the site is served from (Deployment.md §B22).
# GOOGLE_CLIENT_ID=754008456964-dqo6ro2fn6hqcejvtoa7djpe1i8sq5ev.apps.googleusercontent.com
# Provider (server/src/otp/providers.js):
#   fixed   – local testing: every code is OTP_FIXED_CODE (refused when NODE_ENV=production)
#   console – local testing: random code printed in the API log
#   email   – temporary production setup: each code is emailed to OTP_EMAIL_TO via SMTP (Gmail);
#             the merchant WhatsApps OTP_HELP_WHATSAPP and you reply with the code
#   whatsapp_reply – free WhatsApp OTP: the user sends us a pre-filled WhatsApp message, we reply with the code
#   whatsapp       – WhatsApp OTP pushed with an approved authentication template (paid per message)
#   sms     – real SMS via Fast2SMS's OTP route: "Your OTP: 123456" to the user's phone (paid per SMS, no DLT
#             registration needed; Deployment.md §B14). Needs FAST2SMS_API_KEY.
#   msg91_whatsapp – WhatsApp OTP pushed through MSG91 with an approved authentication template (paid per message;
#             MSG91 handles the Meta side; Deployment.md §B20). Needs MSG91_AUTH_KEY, MSG91_WHATSAPP_NUMBER, MSG91_WHATSAPP_TEMPLATE.
# Default: fixed in development, email in production.
OTP_PROVIDER=fixed
OTP_FIXED_CODE=898989
OTP_EMAIL_TO=creativebunnyofficial@gmail.com
# Number shown to users on the free tier: "WhatsApp this number to get your OTP".
OTP_HELP_WHATSAPP=919353095481
# WhatsApp OTP via Meta's Cloud API (Deployment.md §B20): OTP_PROVIDER=whatsapp_reply (free: user messages
# us, we reply with the code) or whatsapp (paid authentication template).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=919353095481
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
# Fast2SMS API key for OTP_PROVIDER=sms (fast2sms.com → Dev API → API Authorization Key).
FAST2SMS_API_KEY=
# MSG91 for OTP_PROVIDER=msg91_whatsapp: auth key (Settings → API Keys), the WhatsApp number connected in the
# MSG91 panel (digits, with 91), the approved authentication template's name and language, optional namespace.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_TEMPLATE_LANG=en
MSG91_WHATSAPP_NAMESPACE=
# SMTP for the email provider. Gmail: smtp.gmail.com:465 with an App Password (not your Google password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vocal For Local OTP <creativebunnyofficial@gmail.com>"
# Canonical public URL for SEO (sitemap, canonical links). Leave empty locally.
PUBLIC_URL=
# Google Maps (address search, map pin, "near me"). Optional: without it, addresses are typed and GPS sets the pin.
# Browser key restricted to your domain + Maps JavaScript API, Places API (New), Geocoding API (Deployment.md §B19).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Shoppers see businesses within this many km (default 10).
NEARBY_RADIUS_KM=10
# Optional search-engine verification (content="…" of the meta tag). DNS TXT verification needs neither.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
